[configuration]
entry_symbol = "defn_core_library_init"
compatibility_minimum = "4.6"

[libraries]
windows.debug.x86_64 = "res://bin/defn_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/defn_core.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libdefn_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libdefn_core.linux.template_release.x86_64.so"
web.debug.wasm32 = "res://bin/libdefn_core.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/libdefn_core.web.template_release.wasm32.nothreads.wasm"
