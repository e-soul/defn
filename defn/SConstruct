import shutil
import subprocess


def remove_flags(flags, flags_to_remove):
    return [flag for flag in flags if str(flag) not in flags_to_remove]


def remove_cppdefine(defines, name):
    def define_name(define):
        if isinstance(define, (tuple, list)) and define:
            return str(define[0])
        return str(define).split("=", maxsplit=1)[0]

    return [define for define in defines if define_name(define) != name]


def parse_bool_arg(value):
    return str(value).lower() in {"1", "true", "yes", "on"}


with_hosted_tests_arg = parse_bool_arg(ARGUMENTS.pop("with_hosted_tests", ""))
godot_bin_arg = ARGUMENTS.pop("godot_bin", "")
with_tidy_arg = parse_bool_arg(ARGUMENTS.pop("with_tidy", ""))
scenario_arg = ARGUMENTS.pop("scenario", "")
seeds_arg = ARGUMENTS.pop("seeds", "")
out_arg = ARGUMENTS.pop("out", "")

