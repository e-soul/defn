"""Composition root. Public targets and migration notes: BUILD_SYSTEM.md."""

import os
import pathlib
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(".").resolve()))

from build_tools.configuration import extension_environment, native_environment, validate_extension_options
from build_tools.quality import add_check, add_tidy, run_native, run_packaging
from build_tools.runners import RUNNER_OPTIONS, add_preparation, add_runners, boolean, validate_options
from build_tools.selection import select
from build_tools.targets import extension, native

try:
    hosted = boolean(ARGUMENTS.pop("with_hosted_tests", "no"))
    tidy = boolean(ARGUMENTS.pop("with_tidy", "no"))
    godot = ARGUMENTS.pop("godot_bin", "")
    runner_options = {key: ARGUMENTS.pop(key) for key in list(ARGUMENTS) if key in RUNNER_OPTIONS}
    validate_extension_options(ARGUMENTS)
    selection = select(COMMAND_LINE_TARGETS, hosted, tidy, boolean(ARGUMENTS.get("compiledb", "no")))
    validate_options(runner_options, selection.runners)

    if selection.hosted and ARGUMENTS.get("target") == "template_release":
        raise ValueError("Hosted support is debug/test-only; use target=template_debug")
    if (selection.runners or selection.hosted_coverage) and ARGUMENTS.get("platform") in {"web", "android", "ios"}:
        raise ValueError("Godot runners require a host desktop build")

    if selection.native_coverage or selection.hosted_coverage:
        from build_tools import coverage

    native_stamp = native_coverage_stamp = None
    native_coverage_program = None
    if selection.native or selection.native_coverage:
        # Never clone the extension environment: this path need not even have godot-cpp checked out.
        SetOption("num_jobs", max(1, (os.cpu_count() or 2) - 1))
        native_env = native_environment(ARGUMENTS)
        if selection.database:
            native_env.Tool("compilation_db")
        if selection.native:
            program, staged_program, _ = native(native_env)
            native_env.Alias("unit_tests", staged_program)
            if set(COMMAND_LINE_TARGETS).intersection({"test", "test_all"}):
                native_stamp = add_check(native_env, "test", program, run_native)
                native_env.Depends(native_stamp, staged_program)
        if selection.native_coverage:
            instrumented = coverage.configure(native_env.Clone())
            native_coverage_program, staged_coverage_program, _ = native(instrumented, coverage=True)
            native_coverage_stamp = coverage.add_native(instrumented, native_coverage_program)
            instrumented.Depends(native_coverage_stamp, staged_coverage_program)
        if selection.database and not selection.extension:
            database = native_env.CompilationDatabase(ARGUMENTS.get("compiledb_file", "compile_commands.json"))
            native_env.Alias("compiledb", database)
            native_env.Alias("compilation_db", database)

    extension_env = None
    runner_nodes = {}
    hosted_coverage_stamp = None
    if selection.extension:
        extension_env = extension_environment(ARGUMENTS, compilation_database=selection.database)
        extension_env["DEFN_GODOT_BIN"] = godot
        extension_env["DEFN_RUNNER_OPTIONS"] = runner_options
        if selection.hosted_coverage:
            extension_env = coverage.configure(extension_env.Clone())
        library, staged_library, variant_root, inventory, built_objects = extension(
            extension_env, selection.hosted, selection.hosted_coverage)
        extension_env["DEFN_EXTENSION_LIBRARY_PATH"] = library[0].abspath
        extension_env.Alias("extension", staged_library)
        Default(None)
        Default(staged_library)
        if selection.database:
            extension_env.Alias("compilation_db", ARGUMENTS.get("compiledb_file", "compile_commands.json"))
            if boolean(ARGUMENTS.get("compiledb", "no")):
                Default(ARGUMENTS.get("compiledb_file", "compile_commands.json"))
        if selection.tidy:
            checks = add_tidy(extension_env, variant_root, inventory, built_objects)
            if tidy:
                extension_env.Depends(library, checks)
        if selection.runners or selection.hosted_coverage:
            preparation = add_preparation(extension_env, staged_library)
            runner_nodes = add_runners(extension_env, selection.runners, preparation)
            if selection.hosted_coverage:
                hosted_coverage_stamp = coverage.add_hosted(extension_env, preparation)

    packaging_stamp = None
    if selection.packaging:
        packaging_env = Environment(tools=[], ENV=os.environ.copy())
        packaging_stamp = add_check(packaging_env, "packaging", "../scripts/check_export_presets.py", run_packaging)
    if "test_all" in COMMAND_LINE_TARGETS:
        Alias("test_all", [native_stamp, runner_nodes["hosted_test"], runner_nodes["conformance"], packaging_stamp])
    if "coverage" in COMMAND_LINE_TARGETS:
        extension_env["DEFN_NATIVE_COVERAGE_PATH"] = native_coverage_program[0].abspath
        coverage.add_merged(extension_env, native_coverage_stamp, hosted_coverage_stamp)

except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
    print(f"Build configuration error: {error}")
    Exit(1)
